# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection URI (e.g. Supabase Transaction Pooler or direct PostgreSQL URI)
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL= postgresql://postgres.qyejuygjlkcxwhotbjht:Subhankitmyson01%23@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# DB_SSL: Force SSL for PostgreSQL connection (true/false)
DB_SSL=true
